# Salin ke .env.local lalu isi. Jangan pernah commit .env.local.

# Penyedia AI (server saja)
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase (server saja; tidak ada yang memakai prefix NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Batas panggilan AI per hari untuk seluruh aplikasi
DAILY_AI_REQUEST_BUDGET=300

# Garam untuk hash IP pada pembatasan laju (isi string acak panjang)
IP_HASH_SALT=

# Rahasia untuk route cron retensi (dipanggil GitHub Actions)
CRON_SECRET=

# Nomor darurat dan nomor WhatsApp posko yang tampil ke korban.
# Di demo pakai nomor contoh dan biarkan label "contoh" terlihat.
EMERGENCY_NUMBER_LABEL=112
POSKO_WHATSAPP_NUMBER=6281200000000

# Kode kabupaten wilayah kerja (default: Kabupaten Bengkulu Tengah)
REGENCY_CODE=17.09
